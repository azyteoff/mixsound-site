---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getProjectsForStudio, type Project } from "../lib/projects";
import { contact, studioCta, studioPages } from "../data/site";

/**
 * Pages ciblées : /kitchenette, /chut, /comptoir-du-son.
 * Elles étaient déjà publiques sur mixsound.fr sans figurer dans la navigation.
 * Elles restent volontairement hors du sitemap et en `noindex`.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const entries = Object.values(studioPages);
  return Promise.all(
    entries.map(async (page) => ({
      params: { studio: page.slug },
      props: {
        page,
        projects: await getProjectsForStudio(page.orderKey),
      },
    })),
  );
};

interface Props {
  page: (typeof studioPages)[keyof typeof studioPages];
  projects: Project[];
}

const { page, projects } = Astro.props;
---

<BaseLayout
  title={page.seoTitle}
  description={page.seoDescription}
  noindex={true}
>
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1 class="title-lg">{page.title}</h1>
      <p class="lede">{page.lede}</p>
    </header>

    <div class="project-grid">
      {
        projects.map((project, index) => (
          <ProjectCard project={project} eager={index < 2} />
        ))
      }
    </div>

    <section class="studio-cta">
      <p>{studioCta}</p>
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <a class="btn btn--primary" href={`mailto:${contact.email}`}>
          {contact.email}
        </a>
        <a
          class="btn btn--ghost"
          href={contact.cv}
          target="_blank"
          rel="noopener noreferrer">CV PDF</a
        >
      </div>
    </section>
  </div>
</BaseLayout>
